<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- يدعم الإنترنت: مطلوبة لتحميل channels.json/xtream.json والاتصال بسيرفرات
         Xtream مباشرة (لا يوجد أي بروكسي وسيط) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- التطبيق يعمل بلا لمس إطلاقاً (تحكم كامل بالريموت/لوحة مفاتيح)، لذا نصرّح أن
         اللمس غير مطلوب — ضروري حتى تعتبر متاجر التطبيقات وأجهزة Android TV هذا
         التطبيق متوافقاً معها (بدون هذا السطر تُستبعد أجهزة التلفاز افتراضياً) -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- تصريح Leanback (واجهة أندرويد تي‌ڤي) — required="false" يسمح بتثبيت نفس الـ APK
         على هواتف/أجهزة لوحية عادية أيضاً بجانب أجهزة التلفاز -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- ⚠️ ضرورية جداً بدءاً من أندرويد 11 (API 30): بدون هذا التصريح، لا يستطيع
         تطبيقنا "رؤية" ما إذا كان VLC مثبَّتاً على الجهاز إطلاقاً (حتى لو كان مثبَّتاً
         فعلياً)، بسبب قيود خصوصية رؤية الحزم (Package Visibility) — سيفشل فحص
         التثبيت ويفشل فتح VLC بصمت دون هذا السطر تحديداً. -->
    <queries>
        <package android:name="org.videolan.vlc" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme">

            <!-- منفذ الإطلاق العادي (هواتف/أجهزة لوحية) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- منفذ الإطلاق الخاص بواجهة Android TV (Leanback) — بدونه لن يظهر
                 التطبيق إطلاقاً بشاشة تطبيقات جهاز التلفاز -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
